# Premier Utah Real Estate — Environment Variables
# Copy this file to .env.local for local dev, set the same keys in the Railway dashboard for prod.

# Public site URL (used for canonical, OG tags, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (Phase 1)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=homesintooele.com

# CRM integration — Follow Up Boss (recommended) or Lofty
CRM_WEBHOOK_URL=
CRM_API_KEY=

# Database — provided by Railway Postgres plugin
DATABASE_URL=

# Auth — Phase 1 (Lifecycle Account)
NEXTAUTH_URL=
NEXTAUTH_SECRET=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# MLS / IDX integration
# Provider switch: "mock" (default) | "idxbroker" | "bridge" | "trestle" | "spark"
MLS_PROVIDER=mock

# --- IDX Broker (Elm Street) ---
# Premier's current IDX vendor. Keys live in Railway → Variables (never commit).
IDX_BROKER_ACCESS_KEY=
IDX_BROKER_ACCOUNT_ID=
IDX_BROKER_ANCILLARY_KEY=

# --- Bridge Interactive (Zillow Group) — alternate, future ---
BRIDGE_SERVER_TOKEN=
BRIDGE_DATASET=

# --- Direct WFRMLS RESO Web API — alternate, future ---
WFRMLS_API_KEY=
WFRMLS_API_URL=

# Mapping — Mapbox (Phase 1 search and neighborhood pages)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Media — Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — Resend (transactional) + Klaviyo (marketing)
RESEND_API_KEY=
KLAVIYO_API_KEY=
